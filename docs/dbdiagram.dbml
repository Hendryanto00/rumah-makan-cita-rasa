// Physical Data Model - CitaRasa Order
// Copy-paste kode ini ke https://dbdiagram.io untuk melihat diagram

Table roles {
  id bigint [pk, increment]
  name varchar(255) [unique, not null]
  description varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table users {
  id bigint [pk, increment]
  role_id bigint [ref: > roles.id, null, note: 'onDelete: set null, optional (nullable) - user bisa tidak punya role']
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  email_verified_at timestamp [null]
  password varchar(255) [not null]
  phone varchar(255) [null]
  address text [null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table categories {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table menus {
  id bigint [pk, increment]
  category_id bigint [ref: > categories.id, not null, note: 'onDelete: cascade, mandatory']
  name varchar(255) [not null]
  description text [null]
  price decimal(12,2) [not null]
  stock int [default: 0, not null]
  is_active boolean [default: true, not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table carts {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'onDelete: cascade, mandatory, one-to-one']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [ref: > carts.id, not null, note: 'onDelete: cascade, mandatory']
  menu_id bigint [ref: > menus.id, not null, note: 'onDelete: cascade, mandatory']
  quantity int [default: 1, not null]
  subtotal decimal(12,2) [not null]
  notes text [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table orders {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'onDelete: cascade, mandatory']
  order_date timestamp [default: `CURRENT_TIMESTAMP`, not null]
  status enum [default: 'pending', not null, note: 'pending, paid, diproses, selesai, batal']
  total_amount decimal(12,2) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table order_details {
  id bigint [pk, increment]
  order_id bigint [ref: > orders.id, not null, note: 'onDelete: cascade, mandatory']
  menu_id bigint [ref: > menus.id, not null, note: 'onDelete: cascade, mandatory']
  quantity int [not null]
  price decimal(12,2) [not null]
  subtotal decimal(12,2) [not null]
  notes text [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [ref: - orders.id, not null, unique, note: 'onDelete: cascade, mandatory, one-to-one']
  payment_method varchar(255) [not null, note: 'e-wallet, bank_transfer, qris']
  snap_token text [null]
  payment_status enum [default: 'pending', not null, note: 'pending, sukses, gagal']
  transaction_id varchar(255) [null]
  amount decimal(12,2) [not null]
  paid_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table reviews {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'onDelete: cascade, mandatory']
  menu_id bigint [ref: > menus.id, not null, note: 'onDelete: cascade, mandatory']
  rating tinyint [not null, note: '1-5']
  comment text [null]
  status enum [default: 'pending', not null, note: 'pending, approved, hidden']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table reports {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'onDelete: cascade, mandatory']
  report_type varchar(255) [not null, note: 'penjualan, pendapatan, review, menu terlaris']
  period_start date [not null]
  period_end date [not null]
  total_income decimal(15,2) [default: 0, not null]
  total_orders int [default: 0, not null]
  total_customers int [default: 0, not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'onDelete: cascade, mandatory']
  action varchar(255) [not null, note: 'Tambah Menu, Ubah Harga, Ubah Status Pesanan, dll']
  target_table varchar(255) [not null]
  target_id bigint [null]
  description text [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

